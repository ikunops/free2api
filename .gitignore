# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/free2api
/signin_bin
/login.exe
/credit.exe
/free2api.exe
/signin_bin.exe

# Config with secrets (use config.example.json)
config.json

# Build artifacts
*.tmp
__pycache__/

# 运行时产物（API Key / 进程号 / 日志 / 工具草稿目录）
# 为什么显式列 .apikey：它不是 config.json 的别名，而是 login.sh 等工具单独落盘的密钥文件，
# 不写进这里会被 git add -A 直接提交（含明文 api_key）。
.apikey
.server.pid
free2api.pid
*.log
draft_*_folder/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

# 设计/计划文档（但 README.md 与 go:embed 的提示词必须进版本库）
*.md
!README.md
# go:embed 的默认系统提示词。被上面的 *.md 误伤过：文件没进版本库，
# 本机因为有工作区副本照样能编，CI 全新 clone 则直接
# `pattern defaultprompt.md: no matching files found` 编译失败。
!internal/prompt/defaultprompt.md

# 本机调试/验收产物，别进版本库。
/work/
/desktop.exe
/desktop
/free2api*.exe
